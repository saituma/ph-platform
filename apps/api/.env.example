# PH Performance API — environment
# Copy to .env and fill in. Never commit .env.
# Source of truth is src/config/env.ts; production boot HARD-FAILS on the vars marked [prod-required].

# ── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Database [prod-required: DATABASE_URL] ────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/ph_dev
DATABASE_SSL=false
# Direct (non-pooled) connection for migrations. Required when DATABASE_URL points at a
# pgbouncer/Neon pooler — transaction mode breaks the DDL migrations issue. Falls back to DATABASE_URL.
DIRECT_DATABASE_URL=
DATABASE_PREFER_DIRECT=false
# instances × DB_POOL_MAX = total connections. Heroku Postgres Standard-0 caps at 25.
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000

# ── Auth [prod-required: JWT_SECRET] ──────────────────────────────────────
JWT_SECRET=replace-me-with-a-long-random-string
# Dev only. ALLOW_EXPIRED_TOKENS=true sets a 100-YEAR JWT clock tolerance.
# Production boot refuses to start if it is enabled — keep it that way.
ALLOW_EXPIRED_TOKENS=false
ALLOW_JWT_BYPASS=false

# ── Redis ─────────────────────────────────────────────────────────────────
# Upstash REST — API cache + rate limiting. [prod-required: both]
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# TCP Redis for BullMQ queues AND the Socket.IO adapter. Queues are disabled when unset.
REDIS_URL=
SOCKET_REQUIRE_REDIS=false

# ── Background jobs ───────────────────────────────────────────────────────
# The Procfile declares a `worker` dyno, but Heroku starts new process types at 0 dynos.
# With only `web` running, nothing consumes the BullMQ queues: the 5 scheduled reminders
# never fire and queued emails vanish. Leave this ON unless you actually scale `worker` up.
RUN_WORKERS_IN_PROCESS=true

# ── Stripe [prod-required: SECRET_KEY, SUCCESS_URL, CANCEL_URL, + WEBHOOK_SECRET if SECRET_KEY set] ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=http://localhost:3000/stripe/success
STRIPE_CANCEL_URL=http://localhost:3000/stripe/cancel
STRIPE_PRICE_PHP=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PRO=

# ── URLs [prod-required: ADMIN_WEB_URL] ───────────────────────────────────
ADMIN_WEB_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:3000
ONBOARDING_URL=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
REQUEST_BODY_LIMIT=1mb

# ── Media (Cloudflare R2 / S3-compatible) ─────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_MB=25
VIDEO_MAX_MB=200

# ── Email (Resend preferred; SMTP is the fallback) ────────────────────────
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ── Push ──────────────────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=
# Raw JSON or base64-encoded service-account JSON
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Observability ─────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Optional integrations ─────────────────────────────────────────────────
OPEN_AI_API_KEY=
BOOKING_ACTION_SECRET=
TEAM_ATHLETE_EMAIL_DOMAIN=
TURNSTILE_SECRET_KEY=
TURNSTILE_BYPASS=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_PLAY_TESTERS_GROUP=
